PORT=5000
MONGODB_URI=your_mongodb_connection_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
ALADHAN_CALCULATION_METHOD=1
ALADHAN_ASR_SCHOOL=1

# ── Overpass / Mosque Discovery ────────────────────────────────────────────────
